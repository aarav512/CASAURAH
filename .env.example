# demo | production
# production with these values empty closes the portal instead of using demonstration data.
VITE_APP_MODE=demo

# Browser-safe values only. Never put a service-role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Set this in Supabase Edge Function secrets, never in a VITE_ variable.
# SUPABASE_SERVICE_ROLE_KEY=
